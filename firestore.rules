rules_version = '2';

// Anyone who has a trip's code (the document ID) can read and write that
// trip. There are no user accounts in this app — knowing the code is what
// grants access, the same way knowing a link grants access to a shared
// doc. Nobody can list/browse trips they don't already have the code for.
service cloud.firestore {
  match /databases/{database}/documents {
    match /trips/{tripId} {
      allow read, write: if true;
    }
  }
}
